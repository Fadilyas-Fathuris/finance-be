# Database connection URL
DATABASE_URL="postgresql://user:password@localhost:5432/finance_db?schema=public"

# Seeder Configuration (Default Accounts)
# In production, set SEED_DEFAULT_PASSWORD or individual passwords in your deployment environment variables (.env)
SEED_DEFAULT_PASSWORD="ChangeThisPasswordInProduction123!"

